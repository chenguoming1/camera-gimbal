# Include new application modules in an existing generated command-line build.
# CubeIDE regenerates its own source list; filter avoids duplicate link inputs.
GIMBAL_APP_OBJS := $(patsubst ../Core/Src/%.c,Core/Src/%.o,$(wildcard ../Core/Src/gimbal_*.c))
# CubeIDE uses ./Core/... while older generated lists use Core/... .
# Normalize both spellings before deciding which objects need manual linking.
GIMBAL_EXISTING_OBJS := $(patsubst ./%,%,$(OBJS) $(USER_OBJS))
GIMBAL_EXTRA_OBJS := $(filter-out $(GIMBAL_EXISTING_OBJS),$(GIMBAL_APP_OBJS))
OBJS += $(GIMBAL_EXTRA_OBJS)
USER_OBJS += $(GIMBAL_EXTRA_OBJS)
-include $(GIMBAL_APP_OBJS:.o=.d)
